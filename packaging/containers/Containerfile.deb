#
# Entorno de compilación del .deb. Debian 13 (trixie) es la base más antigua con
# Qt >= 6.8, requisito del módulo QML de Luma; el paquete resultante sirve para
# Debian 13+ y Ubuntu 25.04+.

ARG DEBIAN_SUITE=trixie
FROM debian:${DEBIAN_SUITE}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        pkg-config \
        file \
        fakeroot \
        dpkg-dev \
        qt6-base-dev \
        qt6-declarative-dev \
        qt6-l10n-tools \
        qt6-tools-dev-tools \
        qml6-module-qtqml-models \
        qml6-module-qtqml-workerscript \
        qml6-module-qtquick-controls \
        qml6-module-qtquick-dialogs \
        qml6-module-qtquick-layouts \
        qml6-module-qtquick-templates \
        qml6-module-qtquick-window \
        qml6-module-qttest \
        qt6-svg-plugins \
        portaudio19-dev \
        libsndfile1-dev \
        libmpg123-dev \
        libsoundtouch-dev \
    && rm -rf /var/lib/apt/lists/*
